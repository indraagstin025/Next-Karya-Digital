# ENVIRONMENT VARIABLES TEMPLATE - NEXT KARYA FRONTEND
# Salin file ini menjadi `.env.local` lalu isi nilainya.
# Jangan commit `.env.local`.

# 1. Koneksi ke backend
# URL API yang dipanggil dari browser dan harus dapat diakses publik.
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# URL API yang dipanggil dari server Next.js. Opsional; jika kosong,
# frontend memakai NEXT_PUBLIC_API_URL.
BACKEND_API_URL="http://localhost:5000/api/v1"

# 2. Autentikasi CMS
# Harus sama dengan JWT_SECRET di backend. Dipakai proxy untuk memverifikasi
# cookie sesi staf sebelum mengizinkan akses /cms dan /admin.
JWT_SECRET="nextkarya-development-jwt-secret-key-minimum-32-chars"

# Opsional. Dipakai sebagai fallback jika JWT_SECRET tidak diset.
# AUTH_SECRET=""

# 3. Revalidasi cache
# Harus sama dengan WEBHOOK_SECRET di backend. Tanpa nilai ini, endpoint
# /api/revalidate menolak semua permintaan.
WEBHOOK_SECRET="nextkarya-webhook-secret-key-minimum-32-chars"

# 4. Form kontak
# Kunci untuk hashing IP pada rate limit formulir kontak. Minimal 32 karakter.
# Jika kosong, frontend memakai AUTH_SECRET.
CONTACT_IP_HASH_SECRET="nextkarya-contact-ip-hash-secret-minimum-32-chars"

# 5. Media Supabase (opsional)
# Isi hanya jika gambar CMS memakai domain media khusus (custom domain/CDN).
# Domain Supabase standar (*.supabase.co) sudah diizinkan untuk next/image.
# NEXT_PUBLIC_MEDIA_HOST="media.nextkarya.web.id"

# Catatan deploy
# Nilai NEXT_PUBLIC_API_URL dan BACKEND_API_URL dibaca saat build untuk
# rewrite /uploads. Set nilainya di environment build, bukan hanya runtime.
# JWT_SECRET dan WEBHOOK_SECRET harus identik dengan konfigurasi backend.
